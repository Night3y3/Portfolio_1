---
import "@/styles/global.css"
import { DottedGlowBackground } from "@/components/ui/dotted-glow-background"
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sabuj Ghosh — Software Engineer" />
    <meta name="author" content="Sabuj Ghosh" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sabuj Ghosh — Software Engineer" />
    <meta property="og:description" content="Sabuj Ghosh — Software Engineer" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Sabuj Ghosh — Software Engineer" />
    <meta name="twitter:description" content="Sabuj Ghosh — Software Engineer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>Sabuj Ghosh — Software Engineer</title>
  </head>
  <body class="relative bg-background text-foreground">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <DottedGlowBackground
        client:load
        gap={22}
        radius={1.2}
        opacity={0.5}
        darkColor="rgba(255,255,255,0.55)"
        darkGlowColor="rgba(120, 180, 255, 0.6)"
      />
    </div>
    <div class="relative z-0">
      <slot />
    </div>
  </body>
</html>
