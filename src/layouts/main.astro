---
import "@/styles/global.css"
import { DottedGlowBackground } from "@/components/ui/dotted-glow-background"
import sabujLogo from "@/assets/logos/sabuj-logo.png"

const siteUrl = Astro.site ?? Astro.url
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString()
const ogImageUrl = new URL("/og-image.png", siteUrl).toString()

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sabuj Ghosh",
  url: siteUrl.toString(),
  image: ogImageUrl,
  jobTitle: "Software Engineer",
  sameAs: [] as string[],
}
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Make Software Which Feels Fast and Useful" />
    <meta name="author" content="Sabuj Ghosh" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Sabuj Ghosh" />
    <meta property="og:title" content="Sabuj Ghosh — Software Engineer" />
    <meta property="og:description" content="Make Software Which Feels Fast and Useful" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Sabuj Ghosh logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content="Sabuj Ghosh — Software Engineer" />
    <meta name="twitter:description" content="Make Software Which Feels Fast and Useful" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Sabuj Ghosh logo" />
    <link rel="icon" type="image/png" href={sabujLogo.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>Sabuj Ghosh — Software Engineer</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body class="relative bg-background text-foreground">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <DottedGlowBackground
        client:load
        gap={22}
        radius={1.2}
        opacity={0.5}
        darkColor="rgba(255,255,255,0.55)"
        darkGlowColor="rgba(120, 180, 255, 0.6)"
      />
    </div>
    <div class="relative z-0">
      <slot />
    </div>
  </body>
</html>
