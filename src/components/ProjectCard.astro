---
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  image?: ImageMetadata;
}

const { title, description, href, badge, image } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-lg p-3 -mx-3 transition-colors duration-200 hover:bg-secondary/30"
>
  <div class="flex items-center gap-3">
    {image && (
      <Image
        src={image}
        alt={title}
        width={28}
        height={28}
        class="flex-shrink-0 h-7 w-7 object-contain rounded"
      />
    )}
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <h3 class="text-[15px] font-medium text-foreground">{title}</h3>
        {badge && (
          <span class="inline-flex items-center rounded-full bg-background border border-border/40 px-2 py-[1px] text-[10px] font-medium text-muted-foreground uppercase tracking-[0.06em]">
            {badge}
          </span>
        )}
      </div>
      <p class="mt-0.5 text-[14px] text-muted-foreground leading-relaxed">
        {description}
      </p>
    </div>
    <ArrowUpRight className="h-4 w-4 flex-shrink-0 text-muted-foreground/0 group-hover:text-muted-foreground transition-all duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
  </div>
</a>
