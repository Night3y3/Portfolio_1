---
const stack = [
  'TypeScript',
  'React',
  'React Native',
  'Expo',
  'EAS',
  'Next.js',
  'Astro',
  'Node.js',
  'Postgres',
  'MongoDB',
  'AWS',
  'Cloudflare',
  'Docker',
];
---

<section class="pb-24 md:pb-32">
  <div class="max-w-2xl mx-auto px-6">
    <div class="border-t border-border/30 pt-7">
      <p class="mb-6 text-[12px] uppercase tracking-[0.18em] font-medium text-muted-foreground/60">
        Stack
      </p>
      <p class="text-[15px] text-muted-foreground leading-relaxed tracking-[0.01em]">
        {stack.join(' · ')}
      </p>
    </div>
  </div>
</section>
