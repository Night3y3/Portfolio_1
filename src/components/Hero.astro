---
import { EmployerLink } from './EmployerLink';
import houseOfEdtechLogo from '@/assets/logos/houseofedtech-logo.png';
---

<section class="pt-28 pb-10 md:pt-32 md:pb-14">
  <div class="max-w-2xl mx-auto px-6">
    <p class="mb-6 text-[12.5px] uppercase tracking-[0.18em] text-muted-foreground">
      Software Engineer
    </p>
    <h1
      class="font-serif font-normal text-foreground"
      style="font-family: var(--font-serif); font-size: clamp(3.5rem, 11vw, 6rem); line-height: 0.95; letter-spacing: -0.035em;"
    >
      Sabuj<br />
      <em class="italic opacity-55" style="font-family: var(--font-serif);">Ghosh</em>
    </h1>
    <p class="mt-6 text-[17px] md:text-lg text-muted-foreground leading-[1.65]">
      Currently working as a Software Engineer at{' '}
      <EmployerLink
        client:load
        title="House of EdTech"
        href="https://houseofedtech.in"
        image={houseOfEdtechLogo.src}
      />
      .
    </p>
  </div>
</section>
